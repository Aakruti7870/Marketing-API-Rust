# GOLD-e GrowthOS Marketing API Configuration
PORT=4000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=postgresql://golde:password@localhost:5432/marketing_api?sslmode=disable

# Authentication & JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-characters-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-change-in-prod
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# CORS & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# WhatsApp Cloud API & Simulation Fallback
WHATSAPP_SIMULATION_MODE=true
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=100609349493921
WHATSAPP_ACCESS_TOKEN=EAAG_sample_meta_access_token_growthos
WHATSAPP_BUSINESS_ACCOUNT_ID=100609349493920
WHATSAPP_WEBHOOK_VERIFY_TOKEN=growthos_secure_webhook_verify_token
WHATSAPP_APP_SECRET=meta_app_secret_here

# Observability
RUST_LOG=info,golde_marketing_api=debug,tower_http=info
